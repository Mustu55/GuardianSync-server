NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/guardiansync
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h
AI_ENGINE_URL=https://your-ai-domain.example
CORS_ORIGIN=https://your-client-domain.example
SCADA_SIM_INTERVAL=3000
SCADA_AUTO_START=false
SCADA_DEFAULT_INDUSTRY=power_plant
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
RESEND_API_KEY=
EMAIL_FROM=GuardianSync <noreply@your-domain.example>